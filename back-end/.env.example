# ============================================
# 高校固定资产管理系统 — 环境变量模板
# ============================================
# 用法：复制本文件为 back-end/.env（已被 .gitignore 忽略），填入真实值即可。
# 应用启动时通过 application.yml 的 spring.config.import 自动读取：
#   import: optional:file:./.env[.properties]
#
# 格式要求（是"按 properties 解析"，不是完整的 dotenv 语法）：
#   · 不要写 export KEY=value —— properties 会把 "export KEY" 当成键名
#   · 值不要加引号 —— 引号会被当成值的一部分
#   · 值里不要出现 ${...} —— 会被当成占位符二次解析
#
# 优先级：系统环境变量 > .env > application.yml 里的默认值
# 文件不存在时会静默跳过（optional:），因此 CI / 生产环境直接用真实环境变量即可，无需改配置。
# ============================================

# 数据库账号（可选，默认 root）
DB_USERNAME=root

# 数据库密码（必填，缺失会导致启动时连不上 MySQL）
DB_PASSWORD=your_mysql_password

# JWT 签名密钥（必填，长度 >= 32 字节，HS256 要求；未配置时应用启动即失败）
# 生成方式：openssl rand -base64 48
# 切勿把真实值提交到仓库
JWT_SECRET=your_random_secret_at_least_32_bytes

# DeepSeek API Key（可选，用于 LLM 智能盘点分析）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

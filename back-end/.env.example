# ============================================
# 高校固定资产管理系统 — 环境变量清单
# ============================================
# 说明：Spring Boot 不会自动读取本文件。这里只作为「需要配置哪些变量」的清单，
#       请把变量配置到实际运行环境：
#         · IDEA  -> Run/Debug Configurations -> Environment variables
#         · 命令行 -> 启动前 export / $env: 设置
#         · CI     -> Secrets / Variables
#       也可复制为 .env（已被 .gitignore 忽略）后用脚本在启动前加载到当前会话。
# ============================================

# 数据库账号（可选，默认 root）
DB_USERNAME=root

# 数据库密码（必填，缺失会导致 Spring 启动时连不上 MySQL）
DB_PASSWORD=your_mysql_password

# JWT 签名密钥（必填，长度 >= 32 字节，HS256 要求；未配置时应用启动即失败）
# 生成方式：openssl rand -base64 48
# 切勿把真实值提交到仓库
JWT_SECRET=your_random_secret_at_least_32_bytes

# DeepSeek API Key（可选，用于 LLM 智能盘点分析）
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
